rules_version = '2';

// Film-Geek Firestore rules.
//
// Everyone (host + players) signs in anonymously, so request.auth.uid is
// always available. The room doc only ever holds public-safe fields
// (phase, round number, deadline) — the actual answer for the current
// clip lives in rooms/{code}/private/answer, which only the room's host
// (hostUid) can read. This is what stops a player from opening devtools
// and reading the answer out of Firestore before reveal.
//
// Scoring is team-based: rooms/{code}/teams/{teamId} holds each team's
// name/emoji/score. Any signed-in player can create or join a team and
// the host updates scores at reveal — this is a private living-room game
// among friends, not something defended against cheating, so team writes
// are intentionally left open rather than locked to exact-field diffs.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isHost(roomCode) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;
    }

    // Shared clip library, independent of any room — this is the durable
    // source of truth the admin-tagging tool writes to and the host
    // reads from, instead of relying on one browser's localStorage.
    match /clipLibrary/{clipId} {
      allow read, write: if isSignedIn();
    }

    match /rooms/{roomCode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isHost(roomCode);
      // "Finish game" deletes the room and its data so old games don't
      // pile up in Firestore — only the host can trigger that cleanup.
      allow delete: if isHost(roomCode);

      match /private/{docId} {
        allow read, write: if isHost(roomCode);
      }

      match /public/{docId} {
        allow read: if isSignedIn();
        allow write: if isHost(roomCode);
      }

      match /teams/{teamId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isHost(roomCode);
      }

      // create AND update (not just create) — a resubmission (accidental
      // double-tap on "Lock in answer", or confirming a blank-field
      // prompt after an already-landed write) would otherwise hit
      // permission-denied the moment Firestore sees the doc already
      // exists and treats the second write as an update.
      match /rounds/{roundIndex}/guesses/{uid} {
        allow read: if isHost(roomCode) || (isSignedIn() && request.auth.uid == uid);
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isHost(roomCode);
      }

      // Bonus trivia answers — same shape/rules as guesses above, just a
      // separate subcollection since a trivia round can follow the same
      // round index a guess round already used.
      match /rounds/{roundIndex}/trivia/{uid} {
        allow read: if isHost(roomCode) || (isSignedIn() && request.auth.uid == uid);
        allow create, update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isHost(roomCode);
      }
    }
  }
}
